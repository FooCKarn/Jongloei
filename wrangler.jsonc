// Cloudflare Workers config: serves the front-end mock-up in ./mockup and runs
// src/worker.js for Google sign-in (/auth/*) and the account API (/api/*).
// Deploy from the Cloudflare dashboard (Workers Builds): build command empty,
// deploy command `npx wrangler deploy`.
//
// Secrets (Settings > Variables and Secrets, type "Secret"; never commit them):
//   GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, THIRDWEB_SECRET_KEY,
//   STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET
// Without the Google ones the mock-up keeps its demo login; without the thirdweb one
// login works but no ticket wallet is created.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jongloei",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./mockup",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/auth/*", "/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jongloei-db",
      "database_id": "f6a0e115-215f-4985-977d-a2d62fc4b925",
      "migrations_dir": "db/migrations"
    }
  ],
  // Every minute: release seat holds older than 10 minutes and finish minting paid orders.
  "triggers": { "crons": ["* * * * *"] },
  // Workers Logs: console output from requests and the cron, in the dashboard under Observability.
  "observability": { "enabled": true },
  // Needed by `npx wrangler preview`, which Workers Builds runs for non-main branches.
  "previews": {}
}

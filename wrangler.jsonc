// Cloudflare Workers config: serves the Next.js front-end (static export in ./web/out)
// and runs src/worker.js for Google sign-in (/auth/*) and the account API (/api/*).
// Deploy from the Cloudflare dashboard (Workers Builds): deploy command `npx wrangler deploy`
// (or `npx wrangler preview` for PR previews). The "build" block below runs before that
// deploy/preview step regardless of the dashboard's own Build command setting — Workers
// Builds was only configured with a deploy command, so without this, wrangler tried to
// upload ./web/out before it existed ("assets.directory does not exist").
// (The old HTML/CSS mock-up still lives in ./mockup for reference.)
//
// Secrets (Settings > Variables and Secrets, type "Secret"; never commit them):
//   GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, THIRDWEB_SECRET_KEY,
//   STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET
// Without the Google ones the mock-up keeps its demo login; without the thirdweb one
// login works but no ticket wallet is created.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jongloei",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  // Wrangler runs this before deploy/dev/preview, independent of any dashboard build command.
  "build": {
    "command": "npm ci && npm run build",
    "cwd": "./web"
  },
  "assets": {
    "directory": "./web/out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/auth/*", "/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jongloei-db",
      "database_id": "f6a0e115-215f-4985-977d-a2d62fc4b925",
      "migrations_dir": "db/migrations"
    }
  ],
  // Every minute: release seat holds older than 10 minutes and finish minting paid orders.
  "triggers": { "crons": ["* * * * *"] },
  // Workers Logs: console output from requests and the cron, in the dashboard under Observability.
  "observability": { "enabled": true },
  // Needed by `npx wrangler preview`, which Workers Builds runs for non-main branches.
  "previews": {}
}
